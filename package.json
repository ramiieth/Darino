{
  "name": "portfolio-simulator-pwa",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "سامانه پایش پورتفولیو و شبیه‌سازی سرمایه‌گذاری چنددارایی (PWA / RTL / Persian)",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && tsc --noEmit -p tsconfig.server.json && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "db:migrate": "node scripts/migrate-db.mjs",
    "typecheck:server": "tsc --noEmit -p tsconfig.server.json",
    "ensure:schema": "node scripts/ensure-schema.mjs",
    "vercel-build": "node scripts/ensure-schema.mjs && npm run build"
  },
  "dependencies": {
    "@fontsource/vazirmatn": "^5.1.1",
    "@hookform/resolvers": "^3.10.0",
    "@neondatabase/serverless": "^1.1.0",
    "@tanstack/react-query": "^5.62.11",
    "chart.js": "^4.4.7",
    "clsx": "^2.1.1",
    "decimal.js": "^10.6.0",
    "dexie": "^4.0.11",
    "dexie-react-hooks": "^1.1.7",
    "framer-motion": "^11.15.0",
    "lucide-react": "^0.469.0",
    "react": "^18.3.1",
    "react-chartjs-2": "^5.3.0",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.54.2",
    "react-router-dom": "^7.18.2",
    "tailwind-merge": "^2.6.0",
    "zod": "^3.24.1",
    "zustand": "^4.5.7"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "jsdom": "^29.1.1",
    "playwright": "^1.62.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.7.2",
    "vite": "^6.4.3",
    "vite-plugin-pwa": "^0.21.1",
    "vitest": "^4.1.10"
  }
}