{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run vercel-build",
  "outputDirectory": "dist",
  "functions": {
    "api/health.ts": {
      "includeFiles": "db/schema.sql"
    },
    "api/accounting.ts": {
      "includeFiles": "db/schema.sql"
    },
    "api/portfolio.ts": {
      "includeFiles": "db/schema.sql"
    },
    "api/dashboard.ts": {
      "includeFiles": "db/schema.sql"
    }
  },
  "rewrites": [
    {
      "source": "/api/cg/:path*",
      "destination": "/api/cg?__p=/:path*"
    },
    {
      "source": "/api/boros/:path*",
      "destination": "/api/boros?__p=/:path*"
    }
  ]
}
