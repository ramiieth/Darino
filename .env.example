# ============================================================
# DARINO — Environment Variables (Example)
# هیچ مقدار واقعی در این فایل قرار نمی‌گیرد.
# پس از Deploy روی Vercel این متغیرها را در داشبورد Vercel تنظیم کنید.
# ============================================================

# Connection string Neon PostgreSQL — فقط سمت سرور (Vercel Functions)
# مثال: postgresql://user:pass@host.neon.tech/dbname?sslmode=require
DATABASE_URL=

# اختیاری — فقط برای Neon Management API در آینده (نه برای Query معمول)
NEON_API_KEY=

# محیط اجرا: production | development | test
NODE_ENV=

# اختیاری — کلیدهای سرور-سمت Providerها (هرگز در Client قرار نگیرند)
COINGECKO_API_KEY=
ALPHAVANTAGE_API_KEY=

# Read-only wallet portfolio and AI — server only; never use VITE_ prefix
ZERION_API_KEY=
GEMINI_API_KEY=
# Optional model override
GEMINI_MODEL=gemini-3.8-flash

# Optional Arcus spot router catalog access — server only
ARCUS_SPOT_API_KEY=
